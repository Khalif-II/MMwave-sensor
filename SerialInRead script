    void ReadSerial()
    {
        while (ReadThread.IsAlive)
        {
            try
            {
                if (sp.BytesToRead > 1)
                {


                    string indata = sp.ReadLine();
                    byte[] ba = Encoding.Default.GetBytes(indata);
                    var hexString = BitConverter.ToString(ba);
                    hexString = hexString.Replace("-", "");
                    int dataSize = hexString.Length;
                    dataBuffer +=hexString;
                    indexBuffer = indexBuffer + dataSize;
                    
                    ParseHexVals();
                


                }
            }
            catch (SystemException f)
            {
                print(f);
                ReadThread.Abort();
            }

        }
    }
    void ParseHexVals()
    {
       
        string searchStr = "0201040306050807";  
        int dataStartIndex = dataBuffer.IndexOf(searchStr);
        

        if (dataStartIndex == -1)
        {
            
            //MagicOk = 0;
            //qDebug() << " Magic Word Not Found --- local Count:  " << localCount << "DataBufferSize" << dataBuffer.size();
            //break;
        }
        else
        {
            
            int totalPayloadSize_bytes = 40 + 8 + (4 * (33 - 11 + 1));
            totalPayloadSize_bytes += 8 + 128;
            int totalPayloadSize_nibbles = 2 * 256;

             
            try
            {
                
                data = dataBuffer.Substring(dataStartIndex, 512);
                
                  
                dataBuffer = dataBuffer.Remove(dataStartIndex, totalPayloadSize_nibbles );
                dataBuffer = dataBuffer.Remove(0, dataStartIndex);
                if (data.Length>= totalPayloadSize_nibbles)
                {
                    float br = parseValueFloat(data, simplifiedBRIndex, 8);
                    float heartRateTemp = parseValueFloat(data, simplifiedHRIndex, 8); 
                    if (br < 100 && br >= 0)
                      {
                        breathingRate = br;
                      }
                    if (heartRateTemp >=0 && heartRateTemp < 500)
                    {
                        heartRate = heartRateTemp;
                    }
                   
                }
             

            }
            catch
            {
              

            }



           
          
        }
       
    }
